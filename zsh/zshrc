if [[ "${TERM_PROGRAM:-}" == "vscode" && -x "$HOME/.local/bin/agent" ]]; then
  eval "$("$HOME/.local/bin/agent" shell-integration zsh)"
fi

# Resolve this file's real directory even when ~/.zshrc is a symlink.
DOTFILES_ZSH="${${(%):-%N}:A:h}"

# Load tracked modules, reserving local.zsh for the final override layer.
for zsh_file in "$DOTFILES_ZSH"/*.zsh(N); do
  [[ "${zsh_file:t}" == "local.zsh" ]] && continue
  source "$zsh_file"
done
unset zsh_file

# agterm's Install Agent Status Hooks appends this block, with an absolute
# path, to a ~/.zshrc that lacks the begin marker. It finds the marker here.
# >>> agterm agent-status >>>
agterm_status="$HOME/.config/agterm/agent-status/shell/integration.sh"
[[ -r "$agterm_status" ]] && source "$agterm_status"
unset agterm_status
# <<< agterm agent-status <<<

# Machine-local overrides are intentionally loaded once, last.
[[ -r "$DOTFILES_ZSH/local.zsh" ]] && source "$DOTFILES_ZSH/local.zsh"
